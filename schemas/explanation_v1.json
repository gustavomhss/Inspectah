{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspectah.dev/schemas/explanation_v1.json",
  "title": "Explanation v1",
  "description": "Explainability schema for verdict, signal, and decision explanations",
  "type": "object",
  "required": ["id", "type", "target_id", "summary", "reasoning_path"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^exp_[a-zA-Z0-9_]+$",
      "description": "Unique explanation identifier"
    },
    "type": {
      "type": "string",
      "enum": ["verdict", "signal", "relation", "policy", "flow"],
      "description": "Type of explanation"
    },
    "target_id": {
      "type": "string",
      "description": "ID of the entity being explained"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Human-readable summary of the explanation"
    },
    "reasoning_path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReasoningStep"
      },
      "description": "Ordered list of reasoning steps"
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExplanationFactor"
      },
      "description": "Factors that influenced the decision"
    },
    "counterfactuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Counterfactual"
      },
      "description": "What-if scenarios"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context-specific metadata"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the explanation was generated"
    }
  },
  "$defs": {
    "ReasoningStep": {
      "type": "object",
      "required": ["step_number", "description", "inputs", "output"],
      "properties": {
        "step_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequential step number"
        },
        "description": {
          "type": "string",
          "description": "What this step does"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Input references for this step"
        },
        "output": {
          "type": "string",
          "description": "Result of this step"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in this step's output"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Evidence IDs referenced in this step"
        }
      }
    },
    "ExplanationFactor": {
      "type": "object",
      "required": ["name", "value", "weight", "direction"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Factor identifier"
        },
        "value": {
          "type": "string",
          "description": "Factor value"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Factor weight in decision"
        },
        "direction": {
          "type": "string",
          "enum": ["positive", "negative", "neutral"],
          "description": "How this factor influenced the outcome"
        },
        "description": {
          "type": "string",
          "description": "Human-readable explanation of the factor"
        }
      }
    },
    "Counterfactual": {
      "type": "object",
      "required": ["condition", "outcome"],
      "properties": {
        "condition": {
          "type": "string",
          "description": "What-if condition"
        },
        "outcome": {
          "type": "string",
          "description": "Predicted outcome under the condition"
        },
        "likelihood": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Likelihood of this outcome"
        },
        "variables": {
          "type": "object",
          "description": "Variables that would change in this scenario"
        }
      }
    }
  }
}
