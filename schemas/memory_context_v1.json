{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspectah.dev/schemas/memory_context_v1.json",
  "title": "Memory Context v1",
  "description": "Agent memory and context management schema",
  "type": "object",
  "required": ["agent_id", "context_type"],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^agent_[a-zA-Z0-9_]+$",
      "description": "Unique agent identifier"
    },
    "context_type": {
      "type": "string",
      "enum": ["session", "claim", "flow", "global"],
      "description": "Type of context being managed"
    },
    "context_id": {
      "type": "string",
      "description": "Identifier for the specific context instance"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemoryEntry"
      },
      "description": "Memory entries in this context"
    },
    "summary": {
      "$ref": "#/$defs/ContextSummary"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "MemoryEntry": {
      "type": "object",
      "required": ["id", "type", "content", "timestamp"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Entry identifier"
        },
        "type": {
          "type": "string",
          "enum": ["fact", "inference", "observation", "decision", "feedback"],
          "description": "Type of memory entry"
        },
        "content": {
          "type": "string",
          "description": "Entry content"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the entry was created"
        },
        "relevance_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Relevance score for retrieval"
        },
        "source_ref": {
          "type": "string",
          "description": "Reference to the source of this entry"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Related entry IDs"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for categorization"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Time-to-live in seconds, 0 for permanent"
        }
      }
    },
    "ContextSummary": {
      "type": "object",
      "properties": {
        "key_facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Key facts extracted from context"
        },
        "active_claims": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Currently relevant claim IDs"
        },
        "recent_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision_type": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "description": "Recent decisions in this context"
        },
        "confidence_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Overall confidence in context"
        }
      }
    }
  }
}
