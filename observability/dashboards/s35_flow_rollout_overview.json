{
  "title": "S35 - Flow Rollout Overview",
  "description": "Painel de rollout governado por fluxo/versão/modo",
  "panels": [
    {
      "id": "rollout_requests",
      "title": "Rollout Requests por modo",
      "type": "timeseries",
      "unit": "req/min",
      "query": "sum(rate(inspectah_flow_rollout_requests_total[5m])) by (flow_id, flow_version_id, mode)"
    },
    {
      "id": "rollout_success",
      "title": "Promoções de rollout",
      "type": "timeseries",
      "unit": "ops/min",
      "query": "sum(rate(inspectah_flow_rollout_success_total[5m])) by (flow_id, flow_version_id, mode)"
    },
    {
      "id": "rollout_rollbacks",
      "title": "Rollbacks de rollout",
      "type": "timeseries",
      "unit": "ops/min",
      "query": "sum(rate(inspectah_flow_rollout_rollback_total[5m])) by (flow_id, flow_version_id, mode)"
    },
    {
      "id": "rollout_duration",
      "title": "Duração de rollout (p95)",
      "type": "timeseries",
      "unit": "s",
      "query": "histogram_quantile(0.95, sum(rate(inspectah_flow_rollout_duration_seconds_bucket[5m])) by (le, flow_id, flow_version_id, mode))"
    },
    {
      "id": "policy_violations",
      "title": "Violações de política",
      "type": "timeseries",
      "unit": "viol/min",
      "query": "sum(rate(inspectah_flow_policy_violations_total[5m])) by (flow_id, flow_version_id)"
    },
    {
      "id": "catalog_drift",
      "title": "Drift de catálogo",
      "type": "stat",
      "unit": "drifts",
      "query": "sum(increase(inspectah_flow_rollout_catalog_drift_total[1h])) by (flow_id, flow_version_id)"
    },
    {
      "id": "slo_breach",
      "title": "SLO Breaches",
      "type": "stat",
      "unit": "breaches",
      "query": "sum(increase(inspectah_flow_slo_breach_total[1h])) by (flow_id, flow_version_id, slo_id)"
    },
    {
      "id": "newsdata_requests",
      "title": "Newsdata requests vs errors",
      "type": "timeseries",
      "unit": "req/min",
      "query": "sum by(source_id, status) (rate(newsdata_ingest_requests_total[5m]))"
    },
    {
      "id": "newsdata_items",
      "title": "Newsdata items ingeridos",
      "type": "timeseries",
      "unit": "items/min",
      "query": "sum by(source_id) (rate(newsdata_items_ingested_total[5m]))"
    },
    {
      "id": "newsdata_duration_p95",
      "title": "Newsdata duração p95",
      "type": "timeseries",
      "unit": "s",
      "query": "histogram_quantile(0.95, sum by (le, source_id) (rate(newsdata_ingest_duration_seconds_bucket[5m])))"
    }
  ]
}
